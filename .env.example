# NCMS production environment
NCMS_ENVIRONMENT=production
NCMS_SECRET_KEY=replace-with-a-long-random-secret
NCMS_ADMIN_USERNAME=replace-with-admin-username
NCMS_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional production database. If omitted, NCMS uses SQLite at database/ncms.db.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Optional comma-separated hostnames accepted by Flask.
# NCMS_TRUSTED_HOSTS=your-domain.example,www.your-domain.example

# Set true when HTTPS is enabled.
NCMS_SESSION_COOKIE_SECURE=true
