diff --git a/app/campaign/routes.py b/app/campaign/routes.py
index e69de29..651e9cc 100644
--- a/app/campaign/routes.py
+++ b/app/campaign/routes.py
@@ -0,0 +1,74 @@
+from flask import render_template, redirect, url_for, flash, request
+from app.campaign import campaign_bp
+from app.campaign.forms import CampaignForm
+from app.extensions import db
+from app.models import Campaign
+
+
+@campaign_bp.route("/")
+def index():
+    campaigns = Campaign.query.order_by(Campaign.id.desc()).all()
+    return render_template(
+        "campaign/index.html",
+        campaigns=campaigns
+    )
+
+
+@campaign_bp.route("/add", methods=["GET", "POST"])
+def add():
+    form = CampaignForm()
+
+    if form.validate_on_submit():
+        campaign = Campaign(
+            name=form.name.data.strip(),
+            start_date=form.start_date.data,
+            end_date=form.end_date.data,
+            status=form.status.data
+        )
+
+        db.session.add(campaign)
+        db.session.commit()
+
+        flash("Campaign created successfully.", "success")
+        return redirect(url_for("campaign.index"))
+
+    return render_template(
+        "campaign/add.html",
+        form=form
+    )
+
+
+@campaign_bp.route("/edit/<int:id>", methods=["GET", "POST"])
+def edit(id):
+    campaign = Campaign.query.get_or_404(id)
+
+    form = CampaignForm(obj=campaign)
+
+    if form.validate_on_submit():
+        campaign.name = form.name.data.strip()
+        campaign.start_date = form.start_date.data
+        campaign.end_date = form.end_date.data
+        campaign.status = form.status.data
+
+        db.session.commit()
+
+        flash("Campaign updated successfully.", "success")
+        return redirect(url_for("campaign.index"))
+
+    return render_template(
+        "campaign/edit.html",
+        form=form,
+        campaign=campaign
+    )
+
+
+@campaign_bp.route("/delete/<int:id>", methods=["POST"])
+def delete(id):
+    campaign = Campaign.query.get_or_404(id)
+
+    db.session.delete(campaign)
+    db.session.commit()
+
+    flash("Campaign deleted successfully.", "success")
+
+    return redirect(url_for("campaign.index"))
